rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Privacidad Absoluta: Cada usuario sólo accede a su propio documento
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolección aislada de Contraseñas (AES-256 Zero-Knowledge)
      match /vault/{vaultItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Códigos Módulo 10
    match /promo_codes/{codeId} {
      allow read, write: if request.auth != null;
    }
  }
}
