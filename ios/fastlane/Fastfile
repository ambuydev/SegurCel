default_platform(:ios)

platform :ios do
  desc "Build and Upload SegurCel to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    )

    begin
      get_certificates(api_key: api_key)
    rescue => e
      puts "Certificates notice: #{e.message}"
    end

    begin
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.segurcel.segurcel"
      )
    rescue => e
      puts "Profile notice: #{e.message}"
    end

    # Embed provisioning profile if downloaded
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    if profile_path && File.exist?(profile_path)
      sh("mkdir -p ../build/ios/ipa/Payload && cp -r ../build/ios/archive/Runner.xcarchive/Products/Applications/Runner.app ../build/ios/ipa/Payload/ && cp '#{profile_path}' ../build/ios/ipa/Payload/Runner.app/embedded.mobileprovision && cd ../build/ios/ipa && zip -r -q SegurCel.ipa Payload")
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/ipa/SegurCel.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
